{ "manifest_version": 2
, "name": "tabsend"
, "version": "0.0"

, "description": "Sends tabs yo"
, "icons":
    { "48": "icons/48.png"
    }

, "browser_action":
    { "default_icon": "icons/48.png"
    , "default_title": "tabsend default title"
    }
, "background":
    { "scripts": ["background/main.js"]
    }
, "options_ui":
    { "page": "options/page.html"
    }
, "permissions":
    [ "alarms"
    , "tabs"
    , "storage"
    ]
, "optional_permissions":
    [ "<all_urls>"
    ]
}
